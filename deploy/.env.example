# Copy to deploy/.env on the server and fill in. Generate secrets with: openssl rand -hex 32

# Root domain. A records for it, crm.<it> and botanica.<it> point at this server; Caddy gets HTTPS certificates for all three
DOMAIN=guldala.kz

# Letters and digits only: it goes into the database URL as is
POSTGRES_PASSWORD=

# Signs the session cookie; changing it logs everyone out
SESSION_SECRET=

# WhatsApp via Wazzup (spec §12). Empty token = messages are only written to the order journal.
WAZZUP_API_TOKEN=
WAZZUP_CHANNEL_ID=
# Webhooks (stage E) arrive at https://crm.DOMAIN/webhooks/wazzup/<this secret>
WAZZUP_WEBHOOK_SECRET=
# While testing: comma-separated +7XXXXXXXXXX; messages to any other number are not sent (journal + log only). Empty = send to everyone
WAZZUP_TEST_PHONES=

# Shared by the site and the CRM: every request to https://crm.DOMAIN/public/* carries it as X-Public-Secret
CRM_PUBLIC_SECRET=
