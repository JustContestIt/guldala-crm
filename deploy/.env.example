# Copy to deploy/.env on the server and fill in. Generate secrets with: openssl rand -hex 32

# Root domain. A records for it, crm.<it> and botanica.<it> point at this server; Caddy gets HTTPS certificates for all three
DOMAIN=guldala.kz

# Letters and digits only: it goes into the database URL as is
POSTGRES_PASSWORD=

# Signs the session cookie; changing it logs everyone out
SESSION_SECRET=

# WhatsApp via Wazzup (spec §12). Empty token = messages are only written to the order journal.
WAZZUP_API_TOKEN=
WAZZUP_CHANNEL_ID=
# Webhooks (stage E) arrive at https://crm.DOMAIN/webhooks/wazzup/<this secret>
WAZZUP_WEBHOOK_SECRET=
# While testing: comma-separated +7XXXXXXXXXX; messages to any other number are not sent (journal + log only),
# other chats' incoming messages are dropped (not stored, not answered, not sent to OpenAI). Empty = everyone
WAZZUP_TEST_PHONES=

# WhatsApp assistant (spec §19). Empty key = the assistant stays silent; mode, model and reasoning — «Ещё → Ассистент»
OPENAI_API_KEY=

# Order confirmations by e-mail (review 09.11.2026, К23). Empty SMTP_HOST = letters are only logged.
# The mailbox zakaz@tulpan.org lives on the shared hosting: its certificate is *.hoster.kz, so the host is pkz15.hoster.kz
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sender address; empty = SMTP_USER
MAIL_FROM=
# While testing: comma-separated addresses; letters to anyone else are not sent (journal only). Empty = everyone
MAIL_TEST_TO=

# Shared by the site and the CRM: every request to https://crm.DOMAIN/public/* carries it as X-Public-Secret
CRM_PUBLIC_SECRET=
