DATABASE_URL=postgres://guldala:guldala@localhost:5433/guldala
# Integration tests recreate this database from scratch on every run
TEST_DATABASE_URL=postgres://guldala:guldala@localhost:5433/guldala_test

# Signs the session cookie. Any long random string: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password the seed gives to the owner account (login: tatiana)
SEED_OWNER_PASSWORD=

# WhatsApp via Wazzup (spec §12). Empty token = fake provider: messages are logged, not sent.
WAZZUP_API_TOKEN=
WAZZUP_CHANNEL_ID=
# While testing with a real token: comma-separated +7XXXXXXXXXX. Nobody else gets messages, and other chats'
# incoming messages are not stored, not answered by the assistant and not sent to OpenAI
WAZZUP_TEST_PHONES=
# Webhooks arrive at PUBLIC_URL/webhooks/wazzup/<this secret>; subscribe in «Ещё → WhatsApp»
WAZZUP_WEBHOOK_SECRET=
PUBLIC_URL=

# WhatsApp assistant (spec §19). Empty key = the assistant stays silent; mode, model and reasoning — «Ещё → Ассистент»
OPENAI_API_KEY=

# The site (../site) calls /public/* with this header; same value in its .env. Links to the site are built from SITE_URL
CRM_PUBLIC_SECRET=dev-secret
SITE_URL=http://localhost:3000
