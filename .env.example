DATABASE_URL=postgres://guldala:guldala@localhost:5433/guldala
# Integration tests recreate this database from scratch on every run
TEST_DATABASE_URL=postgres://guldala:guldala@localhost:5433/guldala_test

# Signs the session cookie. Any long random string: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password the seed gives to the owner account (login: tatiana)
SEED_OWNER_PASSWORD=

# WhatsApp via Wazzup (spec §12). Empty token = fake provider: messages are logged, not sent.
WAZZUP_API_TOKEN=
WAZZUP_CHANNEL_ID=
